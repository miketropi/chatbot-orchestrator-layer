# ── 9Router (OpenAI-compatible gateway) ────────────────────────────────────────
# Local: 9router chạy mặc định ở cổng 20128  (npm i -g 9router && 9router)
# Cloud: https://9router.com/v1
ROUTER_BASE_URL=http://localhost:20128/v1

# Key lấy ở dashboard 9router (mở http://localhost:20128 → Settings/API Keys)
ROUTER_API_KEY=

# Model: bất kỳ alias 9router hỗ trợ, ví dụ
#   cc/claude-haiku-4-5-20251001   ← rẻ, hợp router/planner
#   cc/claude-sonnet-4-5-20250929
#   glm/glm-4.7
#   if/kimi-k2-thinking            (free)
ROUTER_MODEL=cc/claude-haiku-4-5-20251001

# Timeout mỗi call LLM (ms). Quá hạn → fallback rule-based, không treo UI.
ROUTER_TIMEOUT_MS=30000
